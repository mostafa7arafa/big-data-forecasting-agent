# Override default artifact storage (see analyst.config.Settings)
ANALYST_ARTIFACTS_DIR=

# Dataset and runtime tuning
ANALYST_DATASET=nyc_taxi
ANALYST_MODEL=openai:gpt-6-luna
ANALYST_MAX_BACKGROUND_TASKS=3
ANALYST_MAX_CONCURRENT_QUERIES=3
ANALYST_FORECAST_BUDGET_S=120
ANALYST_INLINE_FORECAST_LIMIT_S=15
ANALYST_NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Provider keys (real values go in .env, which is gitignored)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NANOGPT_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=big-data-agent
LANGSMITH_API_KEY=
